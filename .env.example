# SQLite (local development) — file path relative to project root
DATABASE_URL=file:./walts-warriors.db

# Required: long random string used to sign sessions/tokens
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: switch to Postgres later, e.g.
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/walts_warriors

# File storage: leave unset for local /media (v1). On Vercel, add Blob Storage
# to the project — Vercel sets BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=
