# SQLite (local development) — file path relative to project root
DATABASE_URL=file:./walts-warriors.db

# Required: long random string used to sign sessions/tokens
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres (Supabase). Use the SESSION-mode pooler (port 5432 on
# aws-<x>.pooler.supabase.com). Do NOT use port 6543 (transaction mode):
# it breaks prepared statements and Payload migrations. Do not use the
# IPv6-only db.<ref>.supabase.com host with hosts like Render.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# File storage: Cloudflare R2 via its S3-compatible API (self-hosted, e.g. Render).
# Create a bucket in the Cloudflare dashboard, then an R2 API token with
# "Object Read & Write" scoped to that bucket. Leave all unset for local /media
# disk storage in development.
# R2_BUCKET=walts-warriors-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Email (SMTP) — used for member verification and password-reset emails.
# Leave unset for local dev: the full email (with clickable /verify link) is printed
# to the terminal console when sent. Set the vars for real delivery.
# Gmail example: use an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), paste it into SMTP_PASS with NO spaces.
# SMTP_FROM_ADDRESS must equal SMTP_USER for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmailaddress@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM_ADDRESS=yourgmailaddress@gmail.com
# SMTP_FROM_NAME="Walt's Warriors"
